# Google Gemini API key used by the host chatbot. A free one, no card required,
# comes from https://aistudio.google.com — GOOGLE_API_KEY also works.
GEMINI_API_KEY=...

# Optional: which model the host asks for.
# The current flash models allow only 20 requests a day each on the free tier, so the
# default is a lite one. For a demonstration, gemini-3.5-flash reasons harder.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Shared secret required by the remote MCP server, sent as the X-API-Key header.
# It has to match the value configured on the cloud service.
FRAUD_MCP_API_KEY=change-me

# MCP endpoint of the remote server.
FRAUD_MCP_REMOTE_URL=https://<service>.onrender.com/mcp
